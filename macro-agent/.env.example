# Copy this file to ".env" (same folder) and fill in real values.
# Never commit ".env" — it's already in .gitignore.

# Only needed if you have NOT run `ant auth login` on this machine.
# Get one at https://platform.claude.com -> API keys.
ANTHROPIC_API_KEY=

# https://fred.stlouisfed.org/docs/api/api_key.html (free)
FRED_API_KEY=

# https://www.alphavantage.co/support/#api-key (free)
ALPHAVANTAGE_API_KEY=

# https://site.financialmodelingprep.com/developer/docs (free tier available)
FMP_API_KEY=
